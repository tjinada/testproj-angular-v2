fetch spans, scanLimitGBytes:500
| filter contains(lower(url.path), lower("/api/cdb/"))
| filter span.kind == "server"
| fieldsAdd normalizedPath = url.path
// Strip API Gateway stage prefix (e.g. /prd-BillPayment/, /uat-Foo/)
| fieldsAdd normalizedPath = replacePattern(normalizedPath, "'/prd-' LD:stage '/'", "/")
| fieldsAdd normalizedPath = replacePattern(normalizedPath, "'/uat-' LD:stage '/'", "/")
| fieldsAdd normalizedPath = replacePattern(normalizedPath, "'/dev-' LD:stage '/'", "/")
// Numeric path segments between slashes (handles /transits/0001/foo)
| fieldsAdd normalizedPath = replacePattern(normalizedPath, "'/' INT:n '/'", "/{id}/")
// Numeric segment at end of path (handles /transits/0001 with nothing after)
| fieldsAdd normalizedPath = replacePattern(normalizedPath, "'/' INT:n EOS", "/{id}")
| summarize {
    trafficCount = count(),
    lastSeen = takeMax(start_time),
    latestTraceId = takeFirst(trace.id),
    rawPathSamples = collectDistinct(url.path, limit: 3)
  },
  by: { normalizedPath }
| sort trafficCount desc
| limit 500\


