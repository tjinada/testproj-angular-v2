" y="0" relative="1" as="geometry"><Array as="points"><mxPoint x="1530" y="445"/><mxPoint x="1530" y="395"/></Array></mxGeometry></mxCell><mxCell id="c45" value="/api/cdb/*" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#5F5E5A;strokeWidth=1.5;jumpStyle=arc;jumpSize=10;fontSize=10;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;spacing=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="bos" target="sss1"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c46" value="path TBC" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#5F5E5A;strokeWidth=1.5;jumpStyle=arc;jumpSize=10;fontSize=10;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;spacing=2;exitX=0.68;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="bos" target="mid"><mxGeometry x="0" y="0" relative="1" as="geometry"><Array as="points"><mxPoint x="1700" y="602"/></Array></mxGeometry></mxCell><mxCell id="c47" value="/api/*" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#5F5E5A;strokeWidth=1.5;jumpStyle=arc;jumpSize=10;fontSize=10;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;spacing=2;exitX=0.68;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="bos" target="sss2"><mxGeometry x="0" y="0" relative="1" as="geometry"><Array as="points"><mxPoint x="1700" y="262"/><mxPoint x="2490" y="262"/></Array></mxGeometry></mxCell><mxCell id="c48" value="/api/cdb/*" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#5F5E5A;strokeWidth=1.5;jumpStyle=arc;jumpSize=10;fontSize=10;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;spacing=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sss1" target="chan"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c49" value="/api/*" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#5F5E5A;strokeWidth=1.5;jumpStyle=arc;jumpSize=10;fontSize=10;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;spacing=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="chan" target="sss2"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c50" value="/api/*" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#5F5E5A;strokeWidth=1.5;jumpStyle=arc;jumpSize=10;fontSize=10;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;spacing=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sss2" target="dcgw"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c51" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#5F5E5A;strokeWidth=1.5;jumpStyle=arc;jumpSize=10;fontSize=10;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;spacing=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dcgw" target="dcl"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c52" value="path TBC" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#5F5E5A;strokeWidth=1.5;jumpStyle=arc;jumpSize=10;fontSize=10;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;spacing=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="apic" target="awsgw"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c53" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#5F5E5A;strokeWidth=1.5;jumpStyle=arc;jumpSize=10;fontSize=10;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;spacing=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="awsgw" target="awsl"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c54" value="link from original · confirm" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#E24B4A;strokeWidth=1.5;jumpStyle=arc;jumpSize=10;fontSize=10;fontColor=#E24B4A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;spacing=2;dashed=1;dashPattern=6 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="awsl" target="dcgw"><mxGeometry x="0" y="0" relative="1" as="geometry"><Array as="points"><mxPoint x="2770" y="165"/></Array></mxGeometry></mxCell><mxCell id="c55" value='&lt;b style="font-size:14px;"&gt;CIAM sign-in flow (SIT2): all CIAM calls go to qa2.auth.bmo.com&lt;/b&gt;&lt;br&gt;&lt;b style="color:#185FA5;"&gt;Start sign-in&lt;/b&gt;&lt;br&gt;&lt;span style="background-color:#2C2C2A;color:#FFFFFF;border-radius:9px;padding:0px 5px;font-weight:bold;"&gt;1&lt;/span&gt; CDB SPA → Identity Server  GET /isvaop/oauth2/authorize  ↳ 401 (expected: user not signed in yet)&lt;br&gt;&lt;span style="background-color:#2C2C2A;color:#FFFFFF;border-radius:9px;padding:0px 5px;font-weight:bold;"&gt;2&lt;/span&gt; CDB SPA → loads Authenticator MFE  GET /login/cdb/ciam_mfe.js&lt;br&gt;&lt;b style="color:#185FA5;"&gt;User signs in&lt;/b&gt;&lt;br&gt;&lt;span style="background-color:#2C2C2A;color:#FFFFFF;border-radius:9px;padding:0px 5px;font-weight:bold;"&gt;3&lt;/span&gt; Authenticator MFE → Identity Server  /aac/sps/apiauthsvc/policy/idp_authenticator  ↳ checks username and password&lt;br&gt;&lt;span style="background-color:#2C2C2A;color:#FFFFFF;border-radius:9px;padding:0px 5px;font-weight:bold;"&gt;4&lt;/span&gt; Authenticator MFE → Identity Server  /aac/sps/apiauthsvc/policy/idp_macotp  ↳ checks OTP (only if required)&lt;br&gt;&lt;b style="color:#185FA5;"&gt;Get tokens&lt;/b&gt;&lt;br&gt;&lt;span style="background-color:#2C2C2A;color:#FFFFFF;border-radius:9px;padding:0px 5px;font-weight:bold;"&gt;5&lt;/span&gt; CDB SPA → Identity Server  GET /isvaop/oauth2/authorize + DPoP proof  ↳ 200, returns auth code and state&lt;br&gt;&lt;span style="background-color:#2C2C2A;color:#FFFFFF;border-radius:9px;padding:0px 5px;font-weight:bold;"&gt;6&lt;/span&gt; Browser → CDB callback  green.www.olb-qa5.dev.bmo.com/banking/digital/ciam-callback  (not drawn: host TBC)&lt;br&gt;&lt;span style="background-color:#2C2C2A;color:#FFFFFF;border-radius:9px;padding:0px 5px;font-weight:bold;"&gt;7&lt;/span&gt; CDB SPA → Identity Server  POST /isvaop/oauth2/token (auth code + PKCE verifier + DPoP)  ↳ access, refresh and ID tokens&lt;br&gt;&lt;b style="color:#185FA5;"&gt;Start CDB session&lt;/b&gt;&lt;br&gt;&lt;span style="background-color:#2C2C2A;color:#FFFFFF;border-radius:9px;padding:0px 5px;font-weight:bold;"&gt;8&lt;/span&gt; CDB SPA → Akamai → CWH APIC → CDBBOS  /api/cdb-ui/contact-handler/session/initCDBSession  ↳ creates the CDB banking session' style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D3D1C7;align=left;verticalAlign=top;spacing=12;fontSize=11;fontColor=#2C2C2A;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="40" y="880" width="1300" height="330" as="geometry"/></mxCell><mxCell id="c56" value='&lt;b style="font-size:14px;"&gt;Open questions (resolve before KT)&lt;/b&gt;&lt;br&gt;• Direct /banking/services/* from the SPA: where does it exit Akamai? (F5 direct, via ISAM, or unused in SIT2)&lt;br&gt;• Step 6 callback host differs from the SPA host: which box serves it?&lt;br&gt;• How do CWH APIC / CDBBOS validate the CIAM access token?&lt;br&gt;• PKCE code_challenge: sent on step 1 or step 5? DPoP proof at authorize vs dpop_jkt&lt;br&gt;• CWH APIC → AWS API Gateway path; AWS Lambdas → DigitalCore link&lt;br&gt;• ISAM → F5 hop and CDBBOS → Midtier path&lt;br&gt;• Is Legacy ISAM retired once CIAM is live?&lt;br&gt;&lt;br&gt;&lt;b style="color:#993C1D;"&gt;Prod differs: Akamai GTM-CDB-BOS / GTM-CDB-API, BCC/SCC site pinning (cdbbossiteId), EXT GTM in front of BOS LTMs.&lt;/b&gt;' style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D3D1C7;align=left;verticalAlign=top;spacing=12;fontSize=11;fontColor=#2C2C2A;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="1370" y="880" width="980" height="330" as="geometry"/></mxCell><mxCell id="c57" value='&lt;b style="font-size:14px;"&gt;Legend&lt;/b&gt;' style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D3D1C7;align=left;verticalAlign=top;spacing=12;fontSize=11;fontColor=#2C2C2A;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="2380" y="880" width="760" height="330" as="geometry"/></mxCell><mxCell id="c58" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E6F1FB;strokeColor=#185FA5;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2400" y="928" width="40" height="24" as="geometry"/></mxCell><mxCell id="c59" value="Client" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#2C2C2A;spacing=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2450" y="926" width="260" height="28" as="geometry"/></mxCell><mxCell id="c60" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2400" y="964" width="40" height="24" as="geometry"/></mxCell><mxCell id="c61" value="Akamai edge rules / storage" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColo