terPaddingBottom":2,"outerPaddingTop":6,"editable":{"isEditable":true}}},"children":null,"layerId":"L0"}],"layerId":"L0","linkMap":[]},{"x":296,"y":669,"rotation":0,"id":"113","uid":"com.gliffy.shape.basic.basic_v1.default.round_rectangle","width":78,"height":22,"lockAspectRatio":false,"lockShape":false,"flipHorizontal":false,"flipVertical":false,"order":112,"hidden":false,"graphic":{"type":"Shape","Shape":{"tid":"com.gliffy.stencil.round_rectangle.basic_v1","strokeWidth":1,"strokeColor":"#2C2C2A","fillColor":"#2C2C2A","gradient":false,"dropShadow":false,"state":0,"shadowX":0,"shadowY":0,"opacity":1}},"children":[{"x":2,"y":0,"rotation":0,"id":"114","uid":null,"width":74,"height":10.9961,"lockAspectRatio":false,"lockShape":false,"flipHorizontal":false,"flipVertical":false,"order":113,"hidden":false,"graphic":{"type":"Text","Text":{"tid":null,"valign":"middle","overflow":"none","vposition":"none","hposition":"none","html":"<p style=\"text-align:center;\"><span style=\"color:#FFFFFF;font-family:Arial;font-size:10px;\"><span style=\"font-weight: bold; line-height: 11px;\">1 3 4 5 7</span></span></p>","paddingLeft":6,"paddingRight":6,"paddingBottom":6,"paddingTop":6,"outerPaddingLeft":6,"outerPaddingRight":6,"outerPaddingBottom":2,"outerPaddingTop":6,"editable":{"isEditable":true}}},"children":null,"layerId":"L0"}],"layerId":"L0","linkMap":[]},{"x":40,"y":880,"rotation":0,"id":"115","uid":"com.gliffy.shape.basic.basic_v1.default.rectangle","width":1300,"height":300,"lockAspectRatio":false,"lockShape":false,"flipHorizontal":false,"flipVertical":false,"order":114,"hidden":false,"graphic":{"type":"Shape","Shape":{"tid":"com.gliffy.stencil.rectangle.basic_v1","strokeWidth":1,"strokeColor":"#D3D1C7","fillColor":"#FFFFFF","gradient":false,"dropShadow":false,"state":0,"shadowX":0,"shadowY":0,"opacity":1}},"children":[{"x":2,"y":0,"rotation":0,"id":"116","uid":null,"width":1296,"height":215.41,"lockAspectRatio":false,"lockShape":false,"flipHorizontal":false,"flipVertical":false,"order":115,"hidden":false,"graphic":{"type":"Text","Text":{"tid":null,"valign":"top","overflow":"none","vposition":"none","hposition":"none","html":"<p style=\"text-align: left;\"><strong style=\"font-size: 14px; font-family: Arial; color: rgb(44, 44, 42); line-height: 16.5px;\">CIAM sign-in flow (SIT2): all CIAM calls go to qa2.auth.bmo.com</strong></p><p style=\"text-align: left; line-height: normal;\"><br></p><p style=\"text-align: left;\"><strong style=\"font-size: 11px; font-family: Arial; color: rgb(24, 95, 165); line-height: 12px;\">Start sign-in</strong></p><p style=\"text-align: left;\"><span style=\"font-size: 11px; font-family: Arial; color: rgb(44, 44, 42); line-height: 12px;\">1 CDB SPA → Identity Server GET /isvaop/oauth2/authorize ↳ 401 (expected: user not signed in yet)</span></p><p style=\"text-align: left;\"><span style=\"font-size: 11px; font-family: Arial; color: rgb(44, 44, 42); line-height: 12px;\">2 CDB SPA → loads Authenticator MFE GET /login/cdb/ciam_mfe.js</span></p><p style=\"text-align: left; line-height: normal;\"><br></p><p style=\"text-align: left;\"><strong style=\"font-size: 11px; font-family: Arial; color: rgb(24, 95, 165); line-height: 12px;\">User signs in</strong></p><p style=\"text-align: left;\"><span style=\"font-size: 11px; font-family: Arial; color: rgb(44, 44, 42); line-height: 12px;\">3 Authenticator MFE → Identity Server /aac/sps/apiauthsvc/policy/idp_authenticator ↳ checks username and password</span></p><p style=\"text-align: left;\"><span style=\"font-size: 11px; font-family: Arial; color: rgb(44, 44, 42); line-height: 12px;\">4 Authenticator MFE → Identity Server /aac/sps/apiauthsvc/policy/idp_macotp ↳ checks OTP (only if required)</span></p><p style=\"text-align: left; line-height: normal;\"><br></p><p style=\"text-align: left;\"><strong style=\"font-size: 11px; font-family: Arial; color: rgb(24, 95, 165); line-height: 12px;\">Get tokens</strong></p><p style=\"text-align: left;\"><span style=\"font-size: 11px; font-family: Arial; color: rgb(44, 44, 42); line-height: 12px;\">5 CDB SPA → Identity Server GET /isvaop/oauth2/authorize + DPoP proof ↳ 200, returns auth code and state</span></p><p style=\"text-align: left;\"><span style=\"font-size: 11px; font-family: Arial; color: rgb(44, 44, 42); line-height: 12px;\">6 Browser → CDB callback green.www.olb-qa5.dev.bmo.com/banking/digital/ciam-callback</span></p><p style=\"text-align: left;\"><span style=\"font-size: 11px; font-family: Arial; color: rgb(44, 44, 42); line-height: 12px;\">7 CDB SPA → Identity Server POST /isvaop/oauth2/token (auth code + PKCE verifier + DPoP) ↳ access, refresh and ID tokens</span></p><p style=\"text-align: left; line-height: normal;\"><br></p><p style=\"text-align: left;\"><strong style=\"font-size: 11px; font-family: Arial; color: rgb(24, 95, 165); line-height: 12px;\">Start CDB session</strong></p><p style=\"text-align: left;\"><span style=\"font-size: 11px; font-family: Arial; color: rgb(44, 44, 42); line-height: 12px;\">8 CDB SPA → Akamai → CWH APIC → CDBBOS /api/cdb-ui/contact-handler/session/initCDBSession ↳ creates the CDB banking session</span></p>","paddingLeft":6,"paddingRight":6,"paddingBottom":6,"paddingTop":6,"outerPaddingLeft":6,"outerPaddingRight":6,"outerPaddingBottom":2,"outerPaddingTop":6,"editable":{"isEditable":true}}},"children":null,"layerId":"L0"}],"layerId":"L0","linkMap":[]},{"x":1380,"y":880,"rotation":0,"id":"117","uid":"com.gliffy.shape.basic.basic_v1.default.rectangle","width":760,"height":300,"lockAspectRatio":false,"lockShape":false,"flipHorizontal":false,"flipVertical":false,"order":116,"hidden":false,"graphic":{"type":"Shape","Shape":{"tid":"com.gliffy.stencil.rectangle.basic_v1","strokeWidth":1,"strokeColor":"#D3D1C7","fillColor":"#FFFFFF","gradient":false,"dropShadow":false,"state":0,"shadowX":0,"shadowY":0,"opacity":1}},"children":[{"x":2,"y":0,"rotation":0,"id":"118","uid":null,"width":756,"height":16.5039,"lockAspectRatio":false,"lockShape":false,"flipHorizontal":f