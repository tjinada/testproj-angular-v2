    "children": [
     {
      "x": 2,
      "y": 2,
      "rotation": 0,
      "id": 70,
      "uid": null,
      "width": 517,
      "height": 246,
      "lockAspectRatio": false,
      "lockShape": false,
      "order": 70,
      "graphic": {
       "type": "Text",
       "Text": {
        "overflow": "none",
        "paddingTop": 6,
        "paddingRight": 6,
        "paddingBottom": 6,
        "paddingLeft": 6,
        "outerPaddingTop": 6,
        "outerPaddingRight": 6,
        "outerPaddingBottom": 2,
        "outerPaddingLeft": 6,
        "type": "fixed",
        "lineTValue": null,
        "linePerpValue": null,
        "cardinalityType": null,
        "html": "<p style='text-align:left;'><span style=\"font-size:13px;font-weight:bold;color:#1A2A33;line-height:1.3;\">Two dependencies for stage 6</span></p><p style='text-align:left;'><span style=\"font-size:11px;font-weight:normal;color:#4A5B66;line-height:1.3;\"><b>1. Host header.</b> APIC-BCC always sends Host: bos-www13.bmo.com, because the gateway script picks the name from its own FQDN and GTM failover is invisible to it. SCC IHS must accept that vhost or the cross-site hop 400s.</span></p><p style='text-align:left;'><span style=\"font-size:11px;font-weight:normal;color:#4A5B66;line-height:1.3;\"><b>2. DNS caching.</b> If APIC caches the A record past the wide IP TTL, the failover never takes effect no matter how correct the F5 config is.</span></p>",
        "tid": null,
        "valign": "top",
        "vposition": "none",
        "hposition": "none"
       }
      },
      "children": []
     }
    ],
    "linkMap": []
   }
  ]
 }
}