      "paddingLeft": 2,
      "outerPaddingTop": 6,
      "outerPaddingRight": 6,
      "outerPaddingBottom": 2,
      "outerPaddingLeft": 6,
      "type": "fixed",
      "lineTValue": null,
      "linePerpValue": null,
      "cardinalityType": null,
      "html": "<p style='text-align:center;'><span style=\"font-size:11px;font-weight:bold;color:#5E9E68;line-height:1.3;\">stage 6 IS THE SAME</span></p><p style='text-align:center;'><span style=\"font-size:9px;font-weight:normal;color:#5E9E68;line-height:1.3;\">DNS decides, every time</span></p>",
      "tid": null,
      "valign": "middle",
      "vposition": "none",
      "hposition": "none"
     }
    },
    "children": [],
    "linkMap": []
   },
   {
    "x": 190,
    "y": 620,
    "rotation": 0,
    "id": 65,
    "uid": "com.gliffy.shape.basic.basic_v1.default.round_rectangle",
    "width": 555,
    "height": 250,
    "lockAspectRatio": false,
    "lockShape": false,
    "order": 65,
    "graphic": {
     "type": "Shape",
     "Shape": {
      "tid": "com.gliffy.stencil.round_rectangle.basic_v1",
      "strokeWidth": 2,
      "strokeColor": "#C9AE3E",
      "fillColor": "#FCF4D6",
      "dashStyle": null,
      "gradient": false,
      "dropShadow": false,
      "state": 0,
      "opacity": 1,
      "shadowX": 0,
      "shadowY": 0
     }
    },
    "children": [
     {
      "x": 2,
      "y": 2,
      "rotation": 0,
      "id": 66,
      "uid": null,
      "width": 551,
      "height": 246,
      "lockAspectRatio": false,
      "lockShape": false,
      "order": 66,
      "graphic": {
       "type": "Text",
       "Text": {
        "overflow": "none",
        "paddingTop": 6,
        "paddingRight": 6,
        "paddingBottom": 6,
        "paddingLeft": 6,
        "outerPaddingTop": 6,
        "outerPaddingRight": 6,
        "outerPaddingBottom": 2,
        "outerPaddingLeft": 6,
        "type": "fixed",
        "lineTValue": null,
        "linePerpValue": null,
        "cardinalityType": null,
        "html": "<p style='text-align:left;'><span style=\"font-size:13px;font-weight:bold;color:#1A2A33;line-height:1.3;\">The difference from the BOS path</span></p><p style='text-align:left;'><span style=\"font-size:11px;font-weight:normal;color:#4A5B66;line-height:1.3;\">Stage 4 sits at the Akamai edge, which can read a cookie. Stage 6 is DNS, which cannot &mdash; a resolver answering a query for bos-www13.bmo.com has no cookie, no JSESSIONID, no request context at all.</span></p><p style='text-align:left;'><span style=\"font-size:11px;font-weight:normal;color:#4A5B66;line-height:1.3;\">So stage 6 runs on <b>every</b> request, new or existing, and can only answer per-name, never per-session.</span></p>",
        "tid": null,
        "valign": "top",
        "vposition": "none",
        "hposition": "none"
       }
      },
      "children": []
     }
    ],
    "linkMap": []
   },
   {
    "x": 785,
    "y": 620,
    "rotation": 0,
    "id": 67,
    "uid": "com.gliffy.shape.basic.basic_v1.default.round_rectangle",
    "width": 555,
    "height": 250,
    "lockAspectRatio": false,
    "lockShape": false,
    "order": 67,
    "graphic": {
     "type": "Shape",
     "Shape": {
      "tid": "com.gliffy.stencil.round_rectangle.basic_v1",
      "strokeWidth": 2,
      "strokeColor": "#C25450",
      "fillColor": "#F9DBDA",
      "dashStyle": null,
      "gradient": false,
      "dropShadow": false,
      "state": 0,
      "opacity": 1,
      "shadowX": 0,
      "shadowY": 0
     }
    },
    "children": [
     {
      "x": 2,
      "y": 2,
      "rotation": 0,
      "id": 68,
      "uid": null,
      "width": 551,
      "height": 246,
      "lockAspectRatio": false,
      "lockShape": false,
      "order": 68,
      "graphic": {
       "type": "Text",
       "Text": {
        "overflow": "none",
        "paddingTop": 6,
        "paddingRight": 6,
        "paddingBottom": 6,
        "paddingLeft": 6,
        "outerPaddingTop": 6,
        "outerPaddingRight": 6,
        "outerPaddingBottom": 2,
        "outerPaddingLeft": 6,
        "type": "fixed",
        "lineTValue": null,
        "linePerpValue": null,
        "cardinalityType": null,
        "html": "<p style='text-align:left;'><span style=\"font-size:13px;font-weight:bold;color:#1A2A33;line-height:1.3;\">What a drain actually does here</span></p><p style='text-align:left;'><span style=\"font-size:11px;font-weight:normal;color:#4A5B66;line-height:1.3;\"><b>Drain at Akamai</b> (stage 4) &rarr; new sessions go to APIC-SCC, existing stay pinned to APIC-BCC. A <b>bleed</b> at the APIC tier.</span></p><p style='text-align:left;'><span style=\"font-size:11px;font-weight:normal;color:#4A5B66;line-height:1.3;\"><b>BOS-BCC health fails</b> (stage 6) &rarr; the wide IP fails over for <b>everyone</b> on APIC-BCC, new and existing alike. A <b>cut</b> at the BOS tier.</span></p><p style='text-align:left;'><span style=\"font-size:11px;font-weight:normal;color:#4A5B66;line-height:1.3;\">Existing sessions moved by stage 6 land on a JVM that does not hold their JSESSIONID, so they break.</span></p>",
        "tid": null,
        "valign": "top",
        "vposition": "none",
        "hposition": "none"
       }
      },
      "children": []
     }
    ],
    "linkMap": []
   },
   {
    "x": 1380,
    "y": 620,
    "rotation": 0,
    "id": 69,
    "uid": "com.gliffy.shape.basic.basic_v1.default.round_rectangle",
    "width": 521,
    "height": 250,
    "lockAspectRatio": false,
    "lockShape": false,
    "order": 69,
    "graphic": {
     "type": "Shape",
     "Shape": {
      "tid": "com.gliffy.stencil.round_rectangle.basic_v1",
