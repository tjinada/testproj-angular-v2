    "order": 57,
    "graphic": {
     "type": "Shape",
     "Shape": {
      "tid": "com.gliffy.stencil.round_rectangle.basic_v1",
      "strokeWidth": 2,
      "strokeColor": "#C9AE3E",
      "fillColor": "#FCF4D6",
      "dashStyle": null,
      "gradient": false,
      "dropShadow": false,
      "state": 0,
      "opacity": 1,
      "shadowX": 0,
      "shadowY": 0
     }
    },
    "children": [
     {
      "x": 2,
      "y": 2,
      "rotation": 0,
      "id": 58,
      "uid": null,
      "width": 636,
      "height": 226,
      "lockAspectRatio": false,
      "lockShape": false,
      "order": 58,
      "graphic": {
       "type": "Text",
       "Text": {
        "overflow": "none",
        "paddingTop": 6,
        "paddingRight": 6,
        "paddingBottom": 6,
        "paddingLeft": 6,
        "outerPaddingTop": 6,
        "outerPaddingRight": 6,
        "outerPaddingBottom": 2,
        "outerPaddingLeft": 6,
        "type": "fixed",
        "lineTValue": null,
        "linePerpValue": null,
        "cardinalityType": null,
        "html": "<p style='text-align:left;'><span style=\"font-size:13px;font-weight:bold;color:#1A2A33;line-height:1.3;\">One decision point</span></p><p style='text-align:left;'><span style=\"font-size:11px;font-weight:normal;color:#4A5B66;line-height:1.3;\">Compare stage 4. A new session asks the GTM. An existing session never does &mdash; the cookie already holds the answer.</span></p><p style='text-align:left;'><span style=\"font-size:11px;font-weight:normal;color:#4A5B66;line-height:1.3;\">So draining this path stops <b>new</b> sessions being assigned to the site, while existing sessions keep going there until their browser closes. A bleed, not a cut.</span></p><p style='text-align:left;'><span style=\"font-size:11px;font-weight:normal;color:#4A5B66;line-height:1.3;\">The pinned target is the F5 LTM VIP itself. If the F5 pool monitor also fails on live.txt, those pinned requests hit an LTM with no live members and get refused &mdash; that is DACT-104.</span></p>",
        "tid": null,
        "valign": "top",
        "vposition": "none",
        "hposition": "none"
       }
      },
      "children": []
     }
    ],
    "linkMap": []
   },
   {
    "x": 880,
    "y": 590,
    "rotation": 0,
    "id": 59,
    "uid": "com.gliffy.shape.basic.basic_v1.default.round_rectangle",
    "width": 640,
    "height": 230,
    "lockAspectRatio": false,
    "lockShape": false,
