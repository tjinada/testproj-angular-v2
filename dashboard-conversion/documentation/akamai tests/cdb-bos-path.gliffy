    "children": [
     {
      "x": 2,
      "y": 2,
      "rotation": 0,
      "id": 60,
      "uid": null,
      "width": 636,
      "height": 226,
      "lockAspectRatio": false,
      "lockShape": false,
      "order": 60,
      "graphic": {
       "type": "Text",
       "Text": {
        "overflow": "none",
        "paddingTop": 6,
        "paddingRight": 6,
        "paddingBottom": 6,
        "paddingLeft": 6,
        "outerPaddingTop": 6,
        "outerPaddingRight": 6,
        "outerPaddingBottom": 2,
        "outerPaddingLeft": 6,
        "type": "fixed",
        "lineTValue": null,
        "linePerpValue": null,
        "cardinalityType": null,
        "html": "<p style='text-align:left;'><span style=\"font-size:13px;font-weight:bold;color:#1A2A33;line-height:1.3;\">If the GTM had answered SCC</span></p><p style='text-align:left;'><span style=\"font-size:11px;font-weight:normal;color:#4A5B66;line-height:1.3;\">Stage 5 resolves to bmonsori-www12.bmo.com, the regex yields \"www12\", and the cookie is written <b>blue-SCC</b>. Traffic lands on the SCC LTM at 142.43.171.25.</span></p><p style='text-align:left;'><span style=\"font-size:11px;font-weight:normal;color:#4A5B66;line-height:1.3;\">Scenario B then pins to SCC through the same wildcard on *SCC*. Nothing else in the flow changes.</span></p>",
        "tid": null,
        "valign": "top",
        "vposition": "none",
        "hposition": "none"
       }
      },
      "children": []
     }
