        <mxCell id="l4e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="l4c2" target="l4c3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="l4e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#b85450;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="l4c3" target="l4c4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="l4e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="l4c4" target="l4c5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="l4e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="l4c5" target="l4c6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="l4e6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="l4c6" target="l4c7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="dn1" value="&lt;b&gt;The drain is incomplete&lt;/b&gt;&lt;br&gt;&lt;br&gt;Renaming live.txt takes BCC out of the &lt;b&gt;BOS&lt;/b&gt; Akamai GTM only. The &lt;b&gt;API&lt;/b&gt; GTM checks TCP:443 against APIC, which is untouched, so it keeps assigning half of all new /api/cdb sessions to APIC-BCC.&lt;br&gt;&lt;br&gt;If you renamed live.txt in order to patch BCC, you have not taken BCC out of the API path at the edge at all." style="shape=note;whiteSpace=wrap;html=1;size=18;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=14;verticalAlign=top;spacingTop=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="190" y="975" width="540" height="270" as="geometry"/></mxCell>
        <mxCell id="dn2" value="&lt;b&gt;Lane 2 is the DACT-104 fork&lt;/b&gt;&lt;br&gt;&lt;br&gt;The pinned target is the F5 LTM VIP itself. Whether an existing /banking session survives depends entirely on what the F5 pool monitor checks.&lt;br&gt;&lt;br&gt;TCP &#8594; BCC keeps serving and sessions bleed out naturally, which is what you want before a patch.&lt;br&gt;&lt;br&gt;live.txt &#8594; no available pool members, pinned requests refused. One file, two control systems." style="shape=note;whiteSpace=wrap;html=1;size=18;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=14;verticalAlign=top;spacingTop=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="750" y="975" width="540" height="270" as="geometry"/></mxCell>
        <mxCell id="dn3" value="&lt;b&gt;Lane 4 breaks regardless&lt;/b&gt;&lt;br&gt;&lt;br&gt;Stage 6 is DNS. It cannot see a cookie or a JSESSIONID, so it moves every request on APIC-BCC to SCC BOS, existing sessions included.&lt;br&gt;&lt;br&gt;There is also a convergence window: until APIC re-resolves, it keeps sending to the BCC LTM, which may already have no live members.&lt;br&gt;&lt;br&gt;No DNS-layer design can bleed. Fixing this means moving the BOS site decision into APIC." style="shape=note;whiteSpace=wrap;html=1;size=18;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=14;verticalAlign=top;spacingTop=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1310" y="975" width="540" height="270" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
