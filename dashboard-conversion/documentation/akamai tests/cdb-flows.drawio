<mxfile host="app.diagrams.net" agent="claude" version="24.0.0">
  <diagram name="BOS path — /banking" id="page-bos">
    <mxGraphModel dx="1900" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1960" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="btitle" value="BOS path &#8212; /banking/servlet* &#183; new session vs existing session&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#666666&quot;&gt;Akamai edge talks to the BOS LTM directly. One routing decision, at stage 4.&lt;/font&gt;" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="56" as="geometry"/></mxCell>

        <mxCell id="bh1" value="1 &#183; BROWSER" style="text;html=1;fontSize=10;fontStyle=1;align=center;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="200" y="100" width="200" height="20" as="geometry"/></mxCell>
        <mxCell id="bh2" value="2 &#183; AKAMAI EDGE" style="text;html=1;fontSize=10;fontStyle=1;align=center;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="440" y="100" width="200" height="20" as="geometry"/></mxCell>
        <mxCell id="bh3" value="3 &#183; COOKIE CHECK" style="text;html=1;fontSize=10;fontStyle=1;align=center;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="680" y="100" width="200" height="20" as="geometry"/></mxCell>
        <mxCell id="bh4" value="4 &#183; AKAMAI GTM" style="text;html=1;fontSize=10;fontStyle=1;align=center;fontColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="920" y="100" width="200" height="20" as="geometry"/></mxCell>
        <mxCell id="bh5" value="5 &#183; TARGET" style="text;html=1;fontSize=10;fontStyle=1;align=center;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1160" y="100" width="200" height="20" as="geometry"/></mxCell>
        <mxCell id="bh6" value="6 &#183; ORIGIN" style="text;html=1;fontSize=10;fontStyle=1;align=center;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1400" y="100" width="200" height="20" as="geometry"/></mxCell>
        <mxCell id="bh7" value="7 &#183; RESULT" style="text;html=1;fontSize=10;fontStyle=1;align=center;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1640" y="100" width="200" height="20" as="geometry"/></mxCell>

        <mxCell id="blaneA" value="" style="rounded=1;fillColor=#f9fbfd;strokeColor=#d9e3ee;" vertex="1" parent="1"><mxGeometry x="30" y="130" width="1820" height="180" as="geometry"/></mxCell>
        <mxCell id="blblA" value="&lt;b&gt;SCENARIO A&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;New session&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;no cookie&lt;/font&gt;" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="150" height="100" as="geometry"/></mxCell>

        <mxCell id="ba1" value="&lt;b&gt;Browser&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;GET www1.bmo.com&lt;br&gt;/banking/servlet/...&lt;br&gt;&lt;br&gt;&lt;i&gt;Cookie: (none)&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="200" y="150" width="200" height="130" as="geometry"/></mxCell>
        <mxCell id="ba2" value="&lt;b&gt;Edge property&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;prod.olb.com_pm v386&lt;br&gt;&lt;br&gt;path match selects&lt;br&gt;the BOS branch&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="440" y="150" width="200" height="130" as="geometry"/></mxCell>
        <mxCell id="ba3" value="&lt;b&gt;No cookie&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;falls through to the&lt;br&gt;GTM path&lt;br&gt;&lt;br&gt;&lt;i&gt;invalid value lands&lt;br&gt;here too&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="680" y="150" width="200" height="130" as="geometry"/></mxCell>
        <mxCell id="ba4" value="&lt;b&gt;GTM decides&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;wlb.www1.prod.bmo.com&lt;br&gt;.akadns.net&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;br&gt;&lt;b&gt;liveness applies HERE&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="920" y="150" width="200" height="130" as="geometry"/></mxCell>
        <mxCell id="ba5" value="&lt;b&gt;Answer = BCC&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;bmonsori-www13.bmo.com&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;br&gt;regex &#8594; &quot;www13&quot;&lt;br&gt;env = blue&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1160" y="150" width="200" height="130" as="geometry"/></mxCell>
        <mxCell id="ba6" value="&lt;b&gt;BOS LTM (BCC)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;198.96.174.25&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&#8594; BOS Web (IHS)&lt;br&gt;&#8594; WAS plugin&lt;br&gt;&#8594; BOS App&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1400" y="150" width="200" height="130" as="geometry"/></mxCell>
        <mxCell id="ba7" value="&lt;b&gt;Session pinned&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Set-Cookie:&lt;br&gt;&lt;b&gt;cdbbossiteId=blue-BCC&lt;/b&gt;&lt;br&gt;&lt;br&gt;+ JSESSIONID&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1640" y="150" width="200" height="130" as="geometry"/></mxCell>

        <mxCell id="blaneB" value="" style="rounded=1;fillColor=#fdf9f9;strokeColor=#eed9d9;" vertex="1" parent="1"><mxGeometry x="30" y="360" width="1820" height="180" as="geometry"/></mxCell>
        <mxCell id="blblB" value="&lt;b&gt;SCENARIO B&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Existing session&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;cdbbossiteId=blue-BCC&lt;/font&gt;" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="150" height="100" as="geometry"/></mxCell>

        <mxCell id="bb1" value="&lt;b&gt;Browser&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;i&gt;Cookie:&lt;br&gt;cdbbossiteId=blue-BCC&lt;br&gt;JSESSIONID=...&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="200" y="385" width="200" height="130" as="geometry"/></mxCell>
        <mxCell id="bb2" value="&lt;b&gt;Edge property&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;i&gt;identical to A&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="440" y="385" width="200" height="130" as="geometry"/></mxCell>
        <mxCell id="bb3" value="&lt;b&gt;Cookie valid&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;blue-BCC is in the&lt;br&gt;allow-list&lt;br&gt;&lt;br&gt;wildcard *BCC* matches&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="680" y="385" width="200" height="130" as="geometry"/></mxCell>
        <mxCell id="bb4" value="&lt;font color=&quot;#999999&quot;&gt;&lt;b&gt;SKIPPED&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;no populate-cname-chain&lt;br&gt;no akadns lookup&lt;br&gt;&lt;br&gt;&lt;b&gt;liveness has no effect&lt;/b&gt;&lt;/font&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b85450;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="920" y="385" width="200" height="130" as="geometry"/></mxCell>
        <mxCell id="bb5" value="&lt;b&gt;Hardcoded&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;bmonsori-www13.bmo.com&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;br&gt;&lt;i&gt;read straight from&lt;br&gt;the rule&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1160" y="385" width="200" height="130" as="geometry"/></mxCell>
        <mxCell id="bb6" value="&lt;b&gt;BOS LTM (BCC)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;same site&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;br&gt;plugin honours&lt;br&gt;JSESSIONID clone-id&lt;br&gt;&#8594; same JVM&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1400" y="385" width="200" height="130" as="geometry"/></mxCell>
        <mxCell id="bb7" value="&lt;b&gt;Session continues&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;nothing to re-issue&lt;br&gt;&lt;br&gt;&lt;i&gt;pinned to BCC until&lt;br&gt;the browser closes&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1640" y="385" width="200" height="130" as="geometry"/></mxCell>

        <mxCell id="bea1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ba1" target="ba2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="bea2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ba2" target="ba3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="bea3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#82b366;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ba3" target="ba4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="bea4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#82b366;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ba4" target="ba5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="bea5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ba5" target="ba6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="bea6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ba6" target="ba7"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="beb1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="bb1" target="bb2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="beb2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="bb2" target="bb3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="beb3" value="bypasses the GTM" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#b85450;fontColor=#b85450;fontStyle=1;fontSize=11;exitX=1;exitY=0.25;entryX=0;entryY=0.25;verticalAlign=bottom;" edge="1" parent="1" source="bb3" target="bb5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1020" y="350"/></Array></mxGeometry></mxCell>
        <mxCell id="beb5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="bb5" target="bb6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="beb6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="bb6" target="bb7"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="bnote" value="&lt;b&gt;One decision point&lt;/b&gt;&lt;br&gt;&lt;br&gt;Compare stage 4. A new session asks the GTM. An existing session never does &#8212; the cookie already holds the answer.&lt;br&gt;&lt;br&gt;So draining this path stops &lt;b&gt;new&lt;/b&gt; sessions being assigned to the site, while existing sessions keep going there until their browser closes. A bleed, not a cut.&lt;br&gt;&lt;br&gt;The pinned target is the F5 LTM VIP itself. If the F5 pool monitor also fails on live.txt, those pinned requests hit an LTM with no live members and get refused &#8212; that is DACT-104." style="shape=note;whiteSpace=wrap;html=1;size=18;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=14;verticalAlign=top;spacingTop=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="600" width="640" height="230" as="geometry"/></mxCell>

        <mxCell id="bnote2" value="&lt;b&gt;If the GTM had answered SCC&lt;/b&gt;&lt;br&gt;&lt;br&gt;Stage 5 resolves to bmonsori-www12.bmo.com, the regex yields &quot;www12&quot;, and the cookie is written &lt;b&gt;blue-SCC&lt;/b&gt;. Traffic lands on the SCC LTM at 142.43.171.25.&lt;br&gt;&lt;br&gt;Scenario B then pins to SCC through the same wildcard on *SCC*. Nothing else in the flow changes.&lt;br&gt;&lt;br&gt;&lt;i&gt;See page 2 for the APIC path, which behaves differently.&lt;/i&gt;" style="shape=note;whiteSpace=wrap;html=1;size=18;fillColor=#f5f5f5;strokeColor=#999999;align=left;spacingLeft=14;verticalAlign=top;spacingTop=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="600" width="640" height="230" as="geometry"/></mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="APIC path — /api/cdb" id="page-apic">
    <mxGraphModel dx="1900" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1960" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="atitle" value="APIC path &#8212; /api/cdb/* &#183; new session vs existing session&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#666666&quot;&gt;Akamai reaches BOS through APIC. &lt;b&gt;Two&lt;/b&gt; routing decisions &#8212; stage 4 and stage 6 &#8212; and only one of them can see the cookie.&lt;/font&gt;" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="56" as="geometry"/></mxCell>

        <mxCell id="ah1" value="1 &#183; BROWSER" style="text;html=1;fontSize=10;fontStyle=1;align=center;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="190" y="100" width="185" height="20" as="geometry"/></mxCell>
        <mxCell id="ah2" value="2 &#183; AKAMAI EDGE" style="text;html=1;fontSize=10;fontStyle=1;align=center;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="408" y="100" width="185" height="20" as="geometry"/></mxCell>
        <mxCell id="ah3" value="3 &#183; COOKIE CHECK" style="text;html=1;fontSize=10;fontStyle=1;align=center;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="626" y="100" width="185" height="20" as="geometry"/></mxCell>
        <mxCell id="ah4" value="4 &#183; AKAMAI GTM" style="text;html=1;fontSize=10;fontStyle=1;align=center;fontColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="844" y="100" width="185" height="20" as="geometry"/></mxCell>
        <mxCell id="ah5" value="5 &#183; APIC" style="text;html=1;fontSize=10;fontStyle=1;align=center;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1062" y="100" width="185" height="20" as="geometry"/></mxCell>
        <mxCell id="ah6" value="6 &#183; EXT GTM (F5)" style="text;html=1;fontSize=10;fontStyle=1;align=center;fontColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1280" y="100" width="185" height="20" as="geometry"/></mxCell>
        <mxCell id="ah7" value="7 &#183; BOS" style="text;html=1;fontSize=10;fontStyle=1;align=center;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1498" y="100" width="185" height="20" as="geometry"/></mxCell>
        <mxCell id="ah8" value="8 &#183; RESULT" style="text;html=1;fontSize=10;fontStyle=1;align=center;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1716" y="100" width="185" height="20" as="geometry"/></mxCell>

        <mxCell id="alaneA" value="" style="rounded=1;fillColor=#f9fbfd;strokeColor=#d9e3ee;" vertex="1" parent="1"><mxGeometry x="30" y="130" width="1890" height="190" as="geometry"/></mxCell>
        <mxCell id="albl A" value="&lt;b&gt;SCENARIO A&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;New session&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;no cookie&lt;/font&gt;" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="175" width="145" height="100" as="geometry"/></mxCell>

        <mxCell id="aa1" value="&lt;b&gt;Browser&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;GET www1.bmo.com&lt;br&gt;/api/cdb/...&lt;br&gt;&lt;br&gt;&lt;i&gt;Cookie: (none)&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="190" y="150" width="185" height="150" as="geometry"/></mxCell>
        <mxCell id="aa2" value="&lt;b&gt;Edge property&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;prod.olb.com_pm v386&lt;br&gt;&lt;br&gt;path match selects&lt;br&gt;the API branch&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="408" y="150" width="185" height="150" as="geometry"/></mxCell>
        <mxCell id="aa3" value="&lt;b&gt;No cookie&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;falls through to the&lt;br&gt;GTM path&lt;br&gt;&lt;br&gt;&lt;i&gt;same cdbbossiteId as&lt;br&gt;the BOS branch&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="626" y="150" width="185" height="150" as="geometry"/></mxCell>
        <mxCell id="aa4" value="&lt;b&gt;DECISION 1&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;wlb.apis.olbb.akadns.net&lt;br&gt;50/50&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&lt;br&gt;&lt;b&gt;picks which APIC site&lt;/b&gt;&lt;br&gt;liveness = TCP:443&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="844" y="150" width="185" height="150" as="geometry"/></mxCell>
        <mxCell id="aa5" value="&lt;b&gt;APIC FS (BCC)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;bmonsori-apisbccprod&lt;br&gt;.bmo.com&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&lt;br&gt;3 APIC instances&lt;br&gt;&lt;i&gt;gateway script reads its&lt;br&gt;own FQDN &#8594; bos-www13&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1062" y="150" width="185" height="150" as="geometry"/></mxCell>
        <mxCell id="aa6" value="&lt;b&gt;DECISION 2&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;bos-www13.bmo.com&lt;br&gt;via gss-bar-bcc /&lt;br&gt;gss-tor-scc&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&lt;br&gt;&lt;b&gt;picks which BOS site&lt;/b&gt;&lt;br&gt;liveness applies&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1280" y="150" width="185" height="150" as="geometry"/></mxCell>
        <mxCell id="aa7" value="&lt;b&gt;BOS LTM (BCC)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;198.96.174.25&lt;br&gt;&#8594; BOS Web (IHS)&lt;br&gt;&#8594; WAS plugin&lt;br&gt;&#8594; BOS App&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1498" y="150" width="185" height="150" as="geometry"/></mxCell>
        <mxCell id="aa8" value="&lt;b&gt;Session pinned&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Set-Cookie:&lt;br&gt;&lt;b&gt;cdbbossiteId=blue-BCC&lt;/b&gt;&lt;br&gt;&lt;br&gt;+ JSESSIONID&lt;br&gt;&lt;i&gt;pins APIC only&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1716" y="150" width="185" height="150" as="geometry"/></mxCell>

        <mxCell id="alaneB" value="" style="rounded=1;fillColor=#fdf9f9;strokeColor=#eed9d9;" vertex="1" parent="1"><mxGeometry x="30" y="380" width="1890" height="190" as="geometry"/></mxCell>
        <mxCell id="alblB" value="&lt;b&gt;SCENARIO B&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Existing session&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;cdbbossiteId=blue-BCC&lt;/font&gt;" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="425" width="145" height="100" as="geometry"/></mxCell>

        <mxCell id="ab1" value="&lt;b&gt;Browser&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&lt;i&gt;Cookie:&lt;br&gt;cdbbossiteId=blue-BCC&lt;br&gt;JSESSIONID=...&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="190" y="400" width="185" height="150" as="geometry"/></mxCell>
        <mxCell id="ab2" value="&lt;b&gt;Edge property&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&lt;i&gt;identical to A&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="408" y="400" width="185" height="150" as="geometry"/></mxCell>
        <mxCell id="ab3" value="&lt;b&gt;Cookie valid&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;blue-BCC in the&lt;br&gt;allow-list&lt;br&gt;&lt;br&gt;wildcard *BCC* matches&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="626" y="400" width="185" height="150" as="geometry"/></mxCell>
        <mxCell id="ab4" value="&lt;font color=&quot;#999999&quot;&gt;&lt;b&gt;SKIPPED&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;no akadns lookup&lt;br&gt;&lt;br&gt;&lt;b&gt;APIC site is pinned&lt;br&gt;by the cookie&lt;/b&gt;&lt;/font&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b85450;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="844" y="400" width="185" height="150" as="geometry"/></mxCell>
        <mxCell id="ab5" value="&lt;b&gt;APIC FS (BCC)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;bmonsori-apisbccprod&lt;br&gt;.bmo.com&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&lt;br&gt;&lt;i&gt;hardcoded in the rule&lt;br&gt;same gateway script&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1062" y="400" width="185" height="150" as="geometry"/></mxCell>
        <mxCell id="ab6" value="&lt;b&gt;DECISION 2&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&lt;b&gt;STILL RUNS&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;bos-www13.bmo.com&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&lt;br&gt;&lt;i&gt;DNS cannot see the&lt;br&gt;cookie &#8212; liveness applies&lt;br&gt;on every request&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1280" y="400" width="185" height="150" as="geometry"/></mxCell>
        <mxCell id="ab7" value="&lt;b&gt;BOS LTM (BCC)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;same site&lt;br&gt;&lt;br&gt;plugin honours&lt;br&gt;JSESSIONID clone-id&lt;br&gt;&#8594; same JVM&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1498" y="400" width="185" height="150" as="geometry"/></mxCell>
        <mxCell id="ab8" value="&lt;b&gt;Session continues&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;nothing to re-issue&lt;br&gt;&lt;br&gt;&lt;i&gt;&#8230; as long as stage 6&lt;br&gt;keeps answering BCC&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1716" y="400" width="185" height="150" as="geometry"/></mxCell>

        <mxCell id="aea1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="aa1" target="aa2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="aea2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="aa2" target="aa3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="aea3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#82b366;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="aa3" target="aa4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="aea4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#82b366;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="aa4" target="aa5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="aea5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#82b366;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="aa5" target="aa6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="aea6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="aa6" target="aa7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="aea7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="aa7" target="aa8"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="aeb1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ab1" target="ab2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="aeb2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ab2" target="ab3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="aeb3" value="bypasses Decision 1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#b85450;fontColor=#b85450;fontStyle=1;fontSize=11;exitX=1;exitY=0.22;entryX=0;entryY=0.22;verticalAlign=bottom;" edge="1" parent="1" source="ab3" target="ab5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="936" y="365"/></Array></mxGeometry></mxCell>
        <mxCell id="aeb5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#82b366;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ab5" target="ab6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="aeb6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ab6" target="ab7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="aeb7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ab7" target="ab8"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="acol4" value="&lt;b&gt;stage 4 DIFFERS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;cookie decides&lt;/font&gt;" style="text;html=1;fontSize=11;align=center;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="844" y="330" width="185" height="40" as="geometry"/></mxCell>
        <mxCell id="acol6" value="&lt;b&gt;stage 6 IS THE SAME&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;DNS decides, every time&lt;/font&gt;" style="text;html=1;fontSize=11;align=center;fontColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1280" y="330" width="185" height="40" as="geometry"/></mxCell>

        <mxCell id="anote1" value="&lt;b&gt;The difference from the BOS path&lt;/b&gt;&lt;br&gt;&lt;br&gt;Stage 4 sits at the Akamai edge, which can read a cookie. Stage 6 is DNS, which cannot &#8212; a resolver answering a query for bos-www13.bmo.com has no cookie, no JSESSIONID, no request context at all.&lt;br&gt;&lt;br&gt;So stage 6 runs on &lt;b&gt;every&lt;/b&gt; request, new or existing, and it can only answer per-name, never per-session.&lt;br&gt;&lt;br&gt;That single fact is why /api/cdb behaves differently from /banking/servlet during a BOS-side event." style="shape=note;whiteSpace=wrap;html=1;size=18;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=14;verticalAlign=top;spacingTop=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="190" y="620" width="555" height="250" as="geometry"/></mxCell>

        <mxCell id="anote2" value="&lt;b&gt;What a drain actually does here&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Drain at Akamai&lt;/b&gt; (stage 4) &#8594; new sessions go to APIC-SCC, existing stay pinned to APIC-BCC. A &lt;b&gt;bleed&lt;/b&gt; at the APIC tier.&lt;br&gt;&lt;br&gt;&lt;b&gt;BOS-BCC health fails&lt;/b&gt; (stage 6) &#8594; the wide IP fails over for &lt;b&gt;everyone&lt;/b&gt; on APIC-BCC, new and existing alike. A &lt;b&gt;cut&lt;/b&gt; at the BOS tier.&lt;br&gt;&lt;br&gt;Existing sessions moved by stage 6 land on a JVM that does not hold their JSESSIONID, so they break." style="shape=note;whiteSpace=wrap;html=1;size=18;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=14;verticalAlign=top;spacingTop=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="785" y="620" width="555" height="250" as="geometry"/></mxCell>

        <mxCell id="anote3" value="&lt;b&gt;Two dependencies for stage 6&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1. Host header.&lt;/b&gt; APIC-BCC always sends Host: bos-www13.bmo.com, because the gateway script picks the name from its own FQDN and the GTM failover is invisible to it. SCC IHS must accept that vhost or the cross-site hop 400s.&lt;br&gt;&lt;br&gt;&lt;b&gt;2. DNS caching.&lt;/b&gt; If APIC caches the A record past the wide IP TTL, the failover never takes effect no matter how correct the F5 config is." style="shape=note;whiteSpace=wrap;html=1;size=18;fillColor=#f5f5f5;strokeColor=#999999;align=left;spacingLeft=14;verticalAlign=top;spacingTop=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1380" y="620" width="521" height="250" as="geometry"/></mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="Scenario &#8212; BCC live.txt renamed" id="page-drain">
    <mxGraphModel dx="1900" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1960" pageHeight="1420" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="dtitle" value="&lt;b&gt;Scenario: BCC /banking/live.txt renamed to dead.txt&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px;color:#666666'&gt;IHS still running, app still healthy &#8212; only the health object is gone. Four outcomes, one per path and session type.&lt;/font&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="56" as="geometry"/></mxCell>
        <mxCell id="dpre" value="&lt;b&gt;What each health check now sees&lt;/b&gt; &#160;&#160; &#8226; Akamai GTM &lt;b&gt;wlb.www1&#8230;akadns.net&lt;/b&gt; (BOS branch), liveness /banking/live.txt &#8594; &lt;font color='#b85450'&gt;&lt;b&gt;BCC DOWN&lt;/b&gt;&lt;/font&gt; &#160;&#160; &#8226; Akamai GTM &lt;b&gt;wlb.apis.olbb.akadns.net&lt;/b&gt; (API branch), liveness TCP:443 on APIC &#8594; &lt;font color='#82b366'&gt;&lt;b&gt;BCC STILL UP, still 50/50&lt;/b&gt;&lt;/font&gt; &#160;&#160; &#8226; EXT GTM / F5, monitors live.txt &#8594; &lt;font color='#b85450'&gt;&lt;b&gt;bos-www13 fails over to SCC&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;spacingLeft=14;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1880" height="60" as="geometry"/></mxCell>
        <mxCell id="dh0" value="1 &#183; BROWSER" style="text;html=1;fontSize=10;fontStyle=1;align=center;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="190" y="170" width="185" height="20" as="geometry"/></mxCell>
        <mxCell id="dh1" value="2 &#183; EDGE" style="text;html=1;fontSize=10;fontStyle=1;align=center;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="408" y="170" width="185" height="20" as="geometry"/></mxCell>
        <mxCell id="dh2" value="3 &#183; COOKIE" style="text;html=1;fontSize=10;fontStyle=1;align=center;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="626" y="170" width="185" height="20" as="geometry"/></mxCell>
        <mxCell id="dh3" value="4 &#183; AKAMAI GTM" style="text;html=1;fontSize=10;fontStyle=1;align=center;fontColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="844" y="170" width="185" height="20" as="geometry"/></mxCell>
        <mxCell id="dh4" value="5 &#183; APIC" style="text;html=1;fontSize=10;fontStyle=1;align=center;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1062" y="170" width="185" height="20" as="geometry"/></mxCell>
        <mxCell id="dh5" value="6 &#183; EXT GTM (F5)" style="text;html=1;fontSize=10;fontStyle=1;align=center;fontColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1280" y="170" width="185" height="20" as="geometry"/></mxCell>
        <mxCell id="dh6" value="7 &#183; BOS" style="text;html=1;fontSize=10;fontStyle=1;align=center;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1498" y="170" width="185" height="20" as="geometry"/></mxCell>
        <mxCell id="dh7" value="8 &#183; OUTCOME" style="text;html=1;fontSize=10;fontStyle=1;align=center;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1716" y="170" width="185" height="20" as="geometry"/></mxCell>
        <mxCell id="l1bg" value="" style="rounded=1;fillColor=#f6fbf7;strokeColor=#d6e8da;" vertex="1" parent="1"><mxGeometry x="30" y="200" width="1890" height="175" as="geometry"/></mxCell>
        <mxCell id="l1lbl" value="&lt;b&gt;/banking/servlet*&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px'&gt;New session&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9px;color:#666666'&gt;no cookie&lt;/font&gt;" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="245" width="145" height="90" as="geometry"/></mxCell>
        <mxCell id="l1c0" value="&lt;b&gt;Browser&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;GET /banking/servlet&lt;br&gt;&lt;br&gt;&lt;i&gt;Cookie: (none)&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="190" y="218" width="185" height="140" as="geometry"/></mxCell>
        <mxCell id="l1c1" value="&lt;b&gt;BOS branch&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;path match&lt;br&gt;prod.olb.com_pm v386&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="408" y="218" width="185" height="140" as="geometry"/></mxCell>
        <mxCell id="l1c2" value="&lt;b&gt;Absent&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;falls through to&lt;br&gt;the GTM path&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="626" y="218" width="185" height="140" as="geometry"/></mxCell>
        <mxCell id="l1c3" value="&lt;b&gt;BCC is DOWN&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;live.txt returns 404&lt;br&gt;&lt;br&gt;&lt;b&gt;answers SCC&lt;/b&gt;&lt;br&gt;&lt;i&gt;health check worked&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="844" y="218" width="185" height="140" as="geometry"/></mxCell>
        <mxCell id="l1c4" value="&lt;i&gt;not in this path&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#cccccc;dashed=1;fontColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="1062" y="218" width="185" height="140" as="geometry"/></mxCell>
        <mxCell id="l1c5" value="&lt;i&gt;not in this path&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#cccccc;dashed=1;fontColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="1280" y="218" width="185" height="140" as="geometry"/></mxCell>
        <mxCell id="l1c6" value="&lt;b&gt;BOS LTM (SCC)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;142.43.171.25&lt;br&gt;&#8594; SCC IHS&lt;br&gt;&#8594; SCC WAS&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1498" y="218" width="185" height="140" as="geometry"/></mxCell>
        <mxCell id="l1c7" value="&lt;b&gt;WORKS&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;Set-Cookie:&lt;br&gt;cdbbossiteId=&lt;b&gt;blue-SCC&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;clean. new session&lt;br&gt;starts on SCC&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1716" y="218" width="185" height="140" as="geometry"/></mxCell>
