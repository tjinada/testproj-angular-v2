  <diagram name="Release Workflow Stages with Sub-steps" id="release-workflow-v2">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Release Sheriff Workflow — Stages with Sub-steps" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="350" y="20" width="600" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Hard gates between stages (solid). Stage 6 runs in parallel with 4 and 5 (dashed)." style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="350" y="55" width="600" height="20" as="geometry" />
        </mxCell>

        <!-- ============ STAGE 1 ============ -->
        <mxCell id="stage1" value="&lt;b style=&quot;font-size:14px;&quot;&gt;Stage 1 — Intake &amp;amp; Setup&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px;&quot;&gt;Release Confluence page, env allocation, fix version, intake tool entry, branch onboarding to Env Matrix&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;align=center;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="180" y="100" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="sub1" value="&lt;div style=&quot;text-align:left;line-height:1.7;&quot;&gt;&lt;b style=&quot;font-size:13px;color:#3a5a7a;&quot;&gt;Sub-steps&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#444;&quot;&gt;• Add Release Confluence page link&lt;br/&gt;• Confirm env allocation (Self Serve link)&lt;br/&gt;• Create Fix Version in JIRA&lt;br/&gt;• Add Intake Checklist Page ID in Admin Portal&lt;br/&gt;• Raise PR to onboard branch on Env Matrix&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f9ff;strokeColor=#9bb8d9;fontSize=11;verticalAlign=middle;align=left;arcSize=12;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="560" y="90" width="320" height="120" as="geometry" />
        </mxCell>
        <mxCell id="link1" style="endArrow=none;html=1;rounded=0;strokeColor=#9bb8d9;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="stage1" target="sub1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ============ STAGE 2 ============ -->
        <mxCell id="stage2" value="&lt;b style=&quot;font-size:14px;&quot;&gt;Stage 2 — Branching &amp;amp; Configs (T-14)&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px;&quot;&gt;Create CDB UI Configs branch, email ADMs, open master JIRA, run Configs Report&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;align=center;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="180" y="270" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="sub2" value="&lt;div style=&quot;text-align:left;line-height:1.7;&quot;&gt;&lt;b style=&quot;font-size:13px;color:#3a5a7a;&quot;&gt;Sub-steps&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#444;&quot;&gt;• Create CDB UI Configs branch off master&lt;br/&gt;• Email ADMs/devs from Scope Intake&lt;br/&gt;• Open master JIRA &amp;quot;CDB UI Configs - RXX&amp;quot;&lt;br/&gt;• Add subtasks per DA team&lt;br/&gt;• Run CDB_Release_Configs_Report in QA Signoff env&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f9ff;strokeColor=#9bb8d9;fontSize=11;verticalAlign=middle;align=left;arcSize=12;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="560" y="260" width="320" height="120" as="geometry" />
        </mxCell>
        <mxCell id="link2" style="endArrow=none;html=1;rounded=0;strokeColor=#9bb8d9;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="stage2" target="sub2"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ============ STAGE 3 ============ -->
        <mxCell id="stage3" value="&lt;b style=&quot;font-size:14px;&quot;&gt;Stage 3 — Build Stabilization (T-7)&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px;&quot;&gt;Platform QA go/no-go, disable Sealights, run Automated Build Pipeline, generate clean QA builds&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;align=center;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="180" y="440" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="sub3" value="&lt;div style=&quot;text-align:left;line-height:1.7;&quot;&gt;&lt;b style=&quot;font-size:13px;color:#3a5a7a;&quot;&gt;Sub-steps&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#444;&quot;&gt;• Coordinate with Platform QA on stable commit&lt;br/&gt;• Disable Sealights via config PR&lt;br/&gt;• Run Automated Build Pipeline post-toggle&lt;br/&gt;• Confirm clean QA deployment builds generated&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f9ff;strokeColor=#9bb8d9;fontSize=11;verticalAlign=middle;align=left;arcSize=12;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="560" y="440" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="link3" style="endArrow=none;html=1;rounded=0;strokeColor=#9bb8d9;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="stage3" target="sub3"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ============ STAGE 4 ============ -->
        <mxCell id="stage4" value="&lt;b style=&quot;font-size:14px;&quot;&gt;Stage 4 — Mobile Build &amp;amp; Distribution (T-5 to T-4)&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px;&quot;&gt;package.json version, run Blue/Green/Prod mobile pipelines, upload to TestFlight + Playstore, share build links&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;align=center;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="180" y="610" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="sub4" value="&lt;div style=&quot;text-align:left;line-height:1.7;&quot;&gt;&lt;b style=&quot;font-size:13px;color:#3a5a7a;&quot;&gt;Sub-steps&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#444;&quot;&gt;• Confirm package.json version (PROD 0/3/6, Blue 1/4/7, Green 2/5/8)&lt;br/&gt;• Update Mobile App Versions Table&lt;br/&gt;• Run CDB_PROD_Blue_Mobile_Build_Publish&lt;br/&gt;• Run CDB_PROD_Green_Mobile_Build_Publish&lt;br/&gt;• Run CDB_PROD_Mobile_Build_Publish&lt;br/&gt;• Upload iOS Pre-PROD → TestFlight&lt;br/&gt;• Share Android Pre-PROD build path&lt;br/&gt;• Distribute PROD Android + iOS builds&lt;br/&gt;• Share Mobile App Build Links with Release Mgmt&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f9ff;strokeColor=#9bb8d9;fontSize=11;verticalAlign=middle;align=left;arcSize=12;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="560" y="580" width="320" height="200" as="geometry" />
        </mxCell>
        <mxCell id="link4" style="endArrow=none;html=1;rounded=0;strokeColor=#9bb8d9;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="stage4" target="sub4"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ============ STAGE 5 ============ -->
        <mxCell id="stage5" value="&lt;b style=&quot;font-size:14px;&quot;&gt;Stage 5 — WAR Promotion (T-4 to T-3)&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px;&quot;&gt;Promote WAR via Azure pipeline (definitionId=8398)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;align=center;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="180" y="850" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="sub5" value="&lt;div style=&quot;text-align:left;line-height:1.7;&quot;&gt;&lt;b style=&quot;font-size:13px;color:#3a5a7a;&quot;&gt;Sub-steps&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#444;&quot;&gt;• Promote WAR via Azure pipeline (definitionId=8398)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f9ff;strokeColor=#9bb8d9;fontSize=11;verticalAlign=middle;align=left;arcSize=12;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="560" y="860" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="link5" style="endArrow=none;html=1;rounded=0;strokeColor=#9bb8d9;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="stage5" target="sub5"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ============ STAGE 6 (parallel) ============ -->
        <mxCell id="stage6" value="&lt;b style=&quot;font-size:14px;&quot;&gt;Stage 6 — Documentation Prep&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px;&quot;&gt;Draft delivery letters, close JIRA subtasks for UI Configs (parallel to Stages 4 &amp;amp; 5)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;verticalAlign=middle;align=center;arcSize=12;dashed=1;dashPattern=8 4;" vertex="1" parent="1">
          <mxGeometry x="180" y="1010" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="sub6" value="&lt;div style=&quot;text-align:left;line-height:1.7;&quot;&gt;&lt;b style=&quot;font-size:13px;color:#8a5a00;&quot;&gt;Sub-steps&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#444;&quot;&gt;• Draft Pre-PROD delivery letter&lt;br/&gt;• Draft PROD delivery letter&lt;br/&gt;• Close JIRA subtasks + master ticket for UI Configs&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff5e6;strokeColor=#e5b56b;fontSize=11;verticalAlign=middle;align=left;arcSize=12;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="560" y="1015" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="link6" style="endArrow=none;html=1;rounded=0;strokeColor=#e5b56b;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="stage6" target="sub6"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ============ STAGE 7 ============ -->
        <mxCell id="stage7" value="&lt;b style=&quot;font-size:14px;&quot;&gt;Stage 7 — Pre-PROD Deployment&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px;&quot;&gt;Deploy configs to WEM servers, validate 3-4 passes, technical validation per CDB Release runbook&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;align=center;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="180" y="1180" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="sub7" value="&lt;div style=&quot;text-align:left;line-height:1.7;&quot;&gt;&lt;b style=&quot;font-size:13px;color:#3a5a7a;&quot;&gt;Sub-steps&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#444;&quot;&gt;• Deploy configs to PROD WEM server&lt;br/&gt;• Validate 3-4 passes&lt;br/&gt;• Execute technical validation per CDB Release runbook&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f9ff;strokeColor=#9bb8d9;fontSize=11;verticalAlign=middle;align=left;arcSize=12;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="560" y="1185" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="link7" style="endArrow=none;html=1;rounded=0;strokeColor=#9bb8d9;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="stage7" target="sub7"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ============ STAGE 8 ============ -->
        <mxCell id="stage8" value="&lt;b style=&quot;font-size:14px;&quot;&gt;Stage 8 — PROD Deployment&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px;&quot;&gt;Repeat config/WAR verification, technical validation, coordinate traffic switch per PROD delivery letter&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;align=center;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="180" y="1350" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="sub8" value="&lt;div style=&quot;text-align:left;line-height:1.7;&quot;&gt;&lt;b style=&quot;font-size:13px;color:#3a5a7a;&quot;&gt;Sub-steps&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#444;&quot;&gt;• Repeat config/WAR verification&lt;br/&gt;• Execute technical validation&lt;br/&gt;• Coordinate traffic switch per PROD delivery letter&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f9ff;strokeColor=#9bb8d9;fontSize=11;verticalAlign=middle;align=left;arcSize=12;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="560" y="1355" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="link8" style="endArrow=none;html=1;rounded=0;strokeColor=#9bb8d9;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="stage8" target="sub8"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ============ STAGE 9 ============ -->
        <mxCell id="stage9" value="&lt;b style=&quot;font-size:14px;&quot;&gt;Stage 9 — Post-Go-Live&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px;&quot;&gt;Update F26 Deployments page, retrofit branches → master (CDB UI, Configs, Freddy), tag repos&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;align=center;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="180" y="1520" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="sub9" value="&lt;div style=&quot;text-align:left;line-height:1.7;&quot;&gt;&lt;b style=&quot;font-size:13px;color:#3a5a7a;&quot;&gt;Sub-steps&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#444;&quot;&gt;• Update build versions on F26 Deployments page&lt;br/&gt;• Retrofit CDB UI release branch → master&lt;br/&gt;• Retrofit CDB Configs release branch → master&lt;br/&gt;• Retrofit Freddy release branch → master&lt;br/&gt;• Tag repos (CDB, CDB_configs, Freddy)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f9ff;strokeColor=#9bb8d9;fontSize=11;verticalAlign=middle;align=left;arcSize=12;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="560" y="1510" width="320" height="120" as="geometry" />
        </mxCell>
        <mxCell id="link9" style="endArrow=none;html=1;rounded=0;strokeColor=#9bb8d9;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="stage9" target="sub9"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ============ STAGE 10 ============ -->
        <mxCell id="stage10" value="&lt;b style=&quot;font-size:14px;&quot;&gt;Stage 10 — Post Mobile App Release&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px;&quot;&gt;Upload PROD dSYM files to Firebase Console&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;align=center;arcSize=12;" vertex="1" parent="1">
