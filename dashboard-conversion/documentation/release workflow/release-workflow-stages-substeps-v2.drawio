        <mxCell id="gate7to8" value="hard gate" style="endArrow=classic;html=1;rounded=0;strokeColor=#2F5B7C;strokeWidth=2;fontSize=10;fontColor=#2F5B7C;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="stage7" target="stage8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="gate8to9" value="hard gate" style="endArrow=classic;html=1;rounded=0;strokeColor=#2F5B7C;strokeWidth=2;fontSize=10;fontColor=#2F5B7C;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="stage8" target="stage9"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="gate9to10" value="hard gate" style="endArrow=classic;html=1;rounded=0;strokeColor=#2F5B7C;strokeWidth=2;fontSize=10;fontColor=#2F5B7C;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="stage9" target="stage10"><mxGeometry relative="1" as="geometry" /></mxCell>

