        <mxCell id="link10" style="endArrow=none;html=1;rounded=0;strokeColor=#9bb8d9;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="stage10" target="sub10"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ============ HARD GATES (between stages, with bypass around Stage 6) ============ -->
        <mxCell id="gate1to2" value="hard gate" style="endArrow=classic;html=1;rounded=0;strokeColor=#2F5B7C;strokeWidth=2;fontSize=10;fontColor=#2F5B7C;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="stage1" target="stage2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="gate2to3" value="hard gate" style="endArrow=classic;html=1;rounded=0;strokeColor=#2F5B7C;strokeWidth=2;fontSize=10;fontColor=#2F5B7C;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="stage2" target="stage3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="gate3to4" value="hard gate" style="endArrow=classic;html=1;rounded=0;strokeColor=#2F5B7C;strokeWidth=2;fontSize=10;fontColor=#2F5B7C;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="stage3" target="stage4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="gate4to5" value="hard gate" style="endArrow=classic;html=1;rounded=0;strokeColor=#2F5B7C;strokeWidth=2;fontSize=10;fontColor=#2F5B7C;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="stage4" target="stage5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="gate5to7" value="hard gate (skips parallel Stage 6)" style="endArrow=classic;html=1;rounded=0;strokeColor=#2F5B7C;strokeWidth=2;fontSize=10;fontColor=#2F5B7C;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="stage5" target="stage7">
