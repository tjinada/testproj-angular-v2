        <mxCell id="sub10" value="&lt;div style=&quot;text-align:left;line-height:1.7;&quot;&gt;&lt;b style=&quot;font-size:13px;color:#3a5a7a;&quot;&gt;Sub-steps&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#444;&quot;&gt;• Upload PROD dSYM files to Firebase Console&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f9ff;strokeColor=#9bb8d9;fontSize=11;verticalAlign=middle;align=left;arcSize=12;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="560" y="1710" width="320" height="80" as="geometry" />
