        <!-- ============ STAGE 8 ============ -->
        <mxCell id="stage8" value="&lt;b style=&quot;font-size:14px;&quot;&gt;Stage 8 — PROD Deployment&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px;&quot;&gt;Repeat config/WAR verification, technical validation, coordinate traffic switch per PROD delivery letter&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;align=center;arcSize=12;" vertex="1" parent="1">
