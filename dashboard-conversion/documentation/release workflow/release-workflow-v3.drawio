        <!-- ============ STAGE 2 ============ -->
        <mxCell id="stage2" value="&lt;b style=&quot;font-size:14px;&quot;&gt;Stage 2 — Branching &amp;amp; Configs (T-14)&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px;&quot;&gt;Create CDB UI Configs branch, email ADMs, open master JIRA, run Configs Report&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;align=center;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="180" y="290" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="sub2" value="&lt;div style=&quot;text-align:left;line-height:1.7;&quot;&gt;&lt;b style=&quot;font-size:13px;color:#3a5a7a;&quot;&gt;Sub-steps&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#444;&quot;&gt;• Create CDB UI Configs branch off master&lt;br/&gt;• Email ADMs/devs from Scope Intake&lt;br/&gt;• Open master JIRA &amp;quot;CDB UI Configs - RXX&amp;quot;&lt;br/&gt;• Add subtasks per DA team&lt;br/&gt;• Run CDB_Release_Configs_Report in QA Signoff env&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f9ff;strokeColor=#9bb8d9;fontSize=11;verticalAlign=middle;align=left;arcSize=12;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="560" y="280" width="380" height="140" as="geometry" />
        </mxCell>
        <mxCell id="chk2" value="&lt;div style=&quot;text-align:left;line-height:1.7;&quot;&gt;&lt;b style=&quot;font-size:13px;color:#4a6a4a;&quot;&gt;Automated Checks&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#444;&quot;&gt;• GitHub API: CDB UI Configs branch exists off master&lt;br/&gt;• Email service: standardized ADM email sent&lt;br/&gt;• JIRA API: master &amp;quot;CDB UI Configs - RXX&amp;quot; ticket created&lt;br/&gt;• JIRA API: subtasks exist per DA team&lt;br/&gt;• Pipeline API: CDB_Release_Configs_Report run completed&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf3df;strokeColor=#9cb88d;fontSize=11;verticalAlign=middle;align=left;arcSize=12;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
