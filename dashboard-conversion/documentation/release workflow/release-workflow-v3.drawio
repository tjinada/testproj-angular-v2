        <mxCell id="link-c4" style="endArrow=none;html=1;rounded=0;strokeColor=#9cb88d;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sub4" target="chk4"><mxGeometry relative="1" as="geometry" /></mxCell>

