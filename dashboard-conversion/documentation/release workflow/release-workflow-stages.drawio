<mxfile host="app.diagrams.net" modified="2026-05-04T00:00:00.000Z" agent="Claude" version="24.0.0">
  <diagram name="Release Workflow Stages" id="release-workflow-stages">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Release Sheriff Workflow — Stages" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="450" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Hard gates between stages (solid). Stage 6 runs in parallel with 4 and 5 (dashed)." style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="150" y="50" width="550" height="20" as="geometry" />
        </mxCell>

        <mxCell id="stage1" value="&lt;b&gt;Stage 1 — Intake &amp;amp; Setup&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#444444&quot;&gt;Release Confluence page, env allocation, fix version, intake tool entry, branch onboarding to Env Matrix&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;align=center;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="100" width="290" height="80" as="geometry" />
        </mxCell>

        <mxCell id="stage2" value="&lt;b&gt;Stage 2 — Branching &amp;amp; Configs (T-14)&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#444444&quot;&gt;Create CDB UI Configs branch, email ADMs, open master JIRA &amp;quot;CDB UI Configs - RXX&amp;quot;, run Configs Report&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;align=center;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="220" width="290" height="80" as="geometry" />
        </mxCell>

        <mxCell id="stage3" value="&lt;b&gt;Stage 3 — Build Stabilization (T-7)&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#444444&quot;&gt;Platform QA go/no-go, disable Sealights, run Automated Build Pipeline, generate clean QA builds&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;align=center;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="340" width="290" height="80" as="geometry" />
        </mxCell>

        <mxCell id="stage4" value="&lt;b&gt;Stage 4 — Mobile Build &amp;amp; Distribution (T-5 to T-4)&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#444444&quot;&gt;package.json version, run Blue/Green/Prod mobile pipelines, upload to TestFlight + Playstore, share build links&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;align=center;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="460" width="290" height="80" as="geometry" />
        </mxCell>

        <mxCell id="stage5" value="&lt;b&gt;Stage 5 — WAR Promotion (T-4 to T-3)&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#444444&quot;&gt;Promote WAR via Azure pipeline (definitionId=8398)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;align=center;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="580" width="290" height="80" as="geometry" />
        </mxCell>

        <mxCell id="stage6" value="&lt;b&gt;Stage 6 — Documentation Prep&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#444444&quot;&gt;Draft Pre-PROD + PROD delivery letters, close JIRA subtasks for UI Configs (parallel to Stages 4 &amp;amp; 5)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;verticalAlign=middle;align=center;arcSize=12;dashed=1;dashPattern=8 4;" vertex="1" parent="1">
          <mxGeometry x="620" y="520" width="200" height="80" as="geometry" />
        </mxCell>

        <mxCell id="stage7" value="&lt;b&gt;Stage 7 — Pre-PROD Deployment&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#444444&quot;&gt;Deploy configs to WEM servers, validate 3-4 passes, technical validation per CDB Release runbook&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;align=center;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="700" width="290" height="80" as="geometry" />
        </mxCell>

        <mxCell id="stage8" value="&lt;b&gt;Stage 8 — PROD Deployment&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#444444&quot;&gt;Repeat config/WAR verification, technical validation, coordinate traffic switch per PROD delivery letter&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;align=center;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="820" width="290" height="80" as="geometry" />
        </mxCell>

        <mxCell id="stage9" value="&lt;b&gt;Stage 9 — Post-Go-Live&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#444444&quot;&gt;Update F26 Deployments page, retrofit branches → master (CDB UI, Configs, Freddy), tag repos&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;align=center;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="940" width="290" height="80" as="geometry" />
        </mxCell>

        <mxCell id="stage10" value="&lt;b&gt;Stage 10 — Post Mobile App Release&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#444444&quot;&gt;Upload PROD dSYM files to Firebase Console&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;align=center;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="1060" width="290" height="80" as="geometry" />
        </mxCell>

