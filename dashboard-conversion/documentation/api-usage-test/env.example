# Copy this file to .env and fill in real values.
# Each script automatically sources ./.env when run from its containing directory.

# --- Required for all scripts ---

# Dynatrace platform API base URL (no trailing slash needed)
DYNATRACE_API_URL=https://<proxy>--<tenant>.prod2.apps.dynatrace.com/platform/storage/query/v1

# Platform bearer token (needs storage:spans:read scope at minimum)
DYNATRACE_TOKEN=dt0c01.XXXXX...

# --- Required for find-traces-by-url.sh and find-traces-by-url-precise.sh ---
# (used to build the trace deep-link in the CSV)
# Not required by map-banking-services-endpoints.sh

DYNATRACE_TENANT_URL=https://<tenant>.apps.dynatrace.com

# --- Optional knobs (uncomment to override defaults) ---

# Seconds to sleep between per-URL / per-trace Dynatrace calls. Default: 1.
# Set to 0 for max throughput. Raise to 2-3 if you hit rate limits or
# QUERY_QUOTA_EXCEEDED errors.
# SLEEP_BETWEEN_URLS=1

# Print HTTP status + request body + response body when an execute call fails.
# Useful for debugging 4xx errors from Dynatrace.
# DEBUG=1

# --- map-banking-services-endpoints.sh only ---

# Cap the Phase 1 endpoint discovery row count. Default: 1000.
# Use a small value (e.g. 10) when fine-tuning the DQL or testing.
# MAX_RESULTS=10

# Skip Phase 2 (downstream CDBBOS lookup). Default: 1 (Phase 2 enabled).
# When 0, the CSV has only entryEndpoint + traceId columns.
# PHASE2=0
