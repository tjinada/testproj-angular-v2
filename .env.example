# Server Configuration
PORT=8080

# TLS/SSL Configuration
NODE_TLS_REJECT_UNAUTHORIZED=0

# Mock mode (set to 'true' to return mock data instead of calling Dynatrace)
USE_MOCK=false

# Hostname patterns to surface in the Environment field of trace results.
# Comma-separated glob patterns. The root span's host is always included
# in addition to any matches.
ENV_HOSTNAME_PATTERNS=*.dev.bmo.com,cgsg-*,api*-sit*

# Individual User Token Mode
# When true, users provide their own Dynatrace platform tokens via the UI.
# Tokens are stored in the browser's localStorage. The .env tokens below
# become optional fallbacks.
INDIVIDUAL_USER_TOKEN=false

# Dynatrace token management URLs (shown to users when individual tokens are enabled)
DYNATRACE_NONPROD_TOKEN_URL=https://your-nonprod-tenant.dynatrace.com/ui/access-tokens
DYNATRACE_PROD_TOKEN_URL=https://your-prod-tenant.dynatrace.com/ui/access-tokens

# Dynatrace Non-Prod
DYNATRACE_NONPROD_API_URL=dynatrace_nonprod_api_url_here
DYNATRACE_NONPROD_TOKEN=your-platform-token-here

# Dynatrace Pre-Prod
DYNATRACE_PREP_API_URL=dynatrace_prep_api_url_here
DYNATRACE_PREP_TOKEN=your-platform-token-here

# Dynatrace Prod
# Set DYNATRACE_PROD_ENABLED=false to hide Prod from the environment dropdown.
DYNATRACE_PROD_ENABLED=true
DYNATRACE_PROD_API_URL=dynatrace_prod_api_url_here
DYNATRACE_PROD_TOKEN=your-platform-token-here


OPENSEARCH_INDEX_OPTIONS=TEST|channels-test-*|fbTimestamp,channels|channels-*|fbTimestamp,Project|project.*